# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173/

# PostgreSQL Connection Configuration
# If DATABASE_URL is set, it will be used as the primary connection method.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codecamp

# Optional individual database configuration fields (fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=codecamp
